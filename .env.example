# RFxchange server-capable runtime
DATABASE_URL=postgres://user:password@host:5432/database
DATABASE_SSL=require

# HMAC secret used to verify the authenticated RFxchange session cookie.
# Use at least 32 random characters and keep it server-side.
RFXCHANGE_SESSION_SECRET=replace-with-a-long-random-server-secret

# Optional MapLibre style override. The app uses MapLibre's public demo style when unset.
NEXT_PUBLIC_RFX_MAP_STYLE_URL=https://demotiles.maplibre.org/style.json
