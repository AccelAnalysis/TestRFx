# Public application origin used for Firebase email-link continuation.
RFX_APP_URL=https://app.rfxchange.com

# Firebase web SDK configuration (safe for the browser; Firebase Security Rules still govern data access).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=http://127.0.0.1:9099

# Firebase Admin uses Application Default Credentials on Firebase App Hosting / Google Cloud.
FIREBASE_PROJECT_ID=
FIREBASE_AUTH_LINK_DOMAIN=

# Microsoft Graph application credentials. Grant only the approved Mail.Send application permission.
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_MAIL_SENDER=

# Login security policy.
RFX_LOGIN_MONITORING_SALT=
RFX_LOGIN_RATE_WINDOW_SECONDS=600
RFX_LOGIN_RATE_MAX_ATTEMPTS=5
RFX_SESSION_STANDARD_HOURS=8
RFX_SESSION_REMEMBERED_DAYS=14
RFX_SESSION_IDLE_MINUTES=30

# Login support destination.
RFX_SUPPORT_EMAIL=
