# RFxchange server-capable runtime
# Development may use .data. Production must point RFXCHANGE_DATA_DIR at durable writable storage.
RFXCHANGE_DATA_DIR=.data
RFXCHANGE_APP_ORIGIN=http://localhost:3000

# Transactional email HTTP gateway. The endpoint must accept the JSON payload documented in
# docs/architecture/ACCOUNT_VERIFICATION.md and return a 2xx status after accepting delivery.
RFXCHANGE_EMAIL_DELIVERY_URL=
RFXCHANGE_EMAIL_DELIVERY_TOKEN=
RFXCHANGE_EMAIL_FROM=

ACCOUNT_VERIFICATION_TTL_SECONDS=1800
ACCOUNT_VERIFICATION_RESEND_COOLDOWN_SECONDS=60
