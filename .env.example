# RFxchange server-capable runtime
DATABASE_URL=postgres://user:password@host:5432/database
DATABASE_SSL=require
DATABASE_POOL_MAX=5

# HMAC secret used for verified onboarding and the active RFx organization session.
# Use at least 32 random characters and keep it server-side.
RFXCHANGE_SESSION_SECRET=replace-with-a-long-random-server-secret

# Version identifiers for the exact Terms / Privacy documents displayed at registration.
# Registration is rejected until both are configured so policy acceptance is never unversioned.
RFX_TERMS_VERSION=
RFX_PRIVACY_VERSION=

# Canonical public application origin used in verification email links.
RFXCHANGE_APP_URL=http://localhost:3000

# Transactional identity email transport.
# The transport must accept POST JSON containing:
# { messageType, from, to, subject, text, html }
IDENTITY_EMAIL_DELIVERY_URL=
IDENTITY_EMAIL_FROM=
IDENTITY_EMAIL_DELIVERY_TOKEN=

# Stripe + organization membership runtime.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RFXCHANGE_FOUNDING_PRICE_LOOKUP_KEY=rfxchange_founding_monthly

# Optional MapLibre style override. The app uses MapLibre's public demo style when unset.
NEXT_PUBLIC_RFX_MAP_STYLE_URL=https://demotiles.maplibre.org/style.json
