# PostgreSQL/PostGIS connection used by production RFxchange services.
DATABASE_URL=postgresql://user:password@host:5432/rfxchange
DATABASE_POOL_MAX=8
# Set only when the database provider requires TLS.
# DATABASE_SSL=require

# Trusted server-to-server bridge from the selected production identity layer.
# Do not expose these values through NEXT_PUBLIC_* variables or browser code.
RFXCHANGE_IDENTITY_BRIDGE_SECRET=replace-with-a-long-random-secret

# Protects the server-side saved-search change-detection runner. A scheduler or
# operations service may call POST /api/exchange/searches/alerts/run with this
# value in x-rfx-search-alert-secret.
RFXCHANGE_SEARCH_ALERT_SECRET=replace-with-another-long-random-secret
